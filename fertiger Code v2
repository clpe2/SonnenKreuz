#include <Servo.h>

/*
 * SOLAR TRACKER - P-CONTROL DUAL SETUP EDITION v2 (MIT SANFTEM START & AUSGABE)
 * Features: 
 * 1. Synchroner Betrieb von ZWEI Solar-Einheiten
 * 2. Hysterese (kein Zittern bei kleinen Wolken)
 * 3. P-Regler (Schnell bei großer Abweichung, sanft am Ziel)
 * 4. Max-Speed-Limit pro Zyklus für weiche Bewegungen
 * 5. Mittelwertbildung (Rauschunterdrückung der Sensoren)
 * 6. NEU: Nacht-/Dunkelheitserkennung (kein zielloses Suchen)
 * 7. NEU: Sensor-Plausibilitätscheck (Schutz bei defektem LDR)
 * 8. NEU: Anti-Rundungs-Stillstand im P-Regler
 * 9. NEU: Einstellbarer, langsamer Sanftanlauf beim Einschalten
 */

// --- 1. PIN KONFIGURATION ---
const int PIN_OBEN   = A3; 
const int PIN_UNTEN  = A1; 
const int PIN_LINKS  = A5; 
const int PIN_RECHTS = A2; 

// Setup 1
const int PIN_SERVO_HORIZ = 6;  
const int PIN_SERVO_VERT  = 5; 

// Setup 2
const int PIN_SERVO_HORIZ_2 = 10; 
const int PIN_SERVO_VERT_2  = 11; 

// --- 2. OBJEKTE ---
Servo servoHorizontal;
Servo servoVertikal;
Servo servoHorizontal2; 
Servo servoVertikal2;   

// --- 3. EINSTELLUNGEN ---

// === NEU: START-GESCHWINDIGKEIT ===
// Pause in Millisekunden pro Grad beim Hochfahren (Je höher die Zahl, desto langsamer)
const int START_GESCHWINDIGKEIT = 30; 

// Anzahl der Messungen für den Mittelwert 
const int MESSUNGEN = 5;

// Hysterese-Totzone (erst ab hier wird geregelt)
const int TOLERANZ = 40;   

// P-REGLER PARAMETER
const float Kp = 0.02;     

// Limitiert die maximale Grad-Änderung pro Takt
const int MAX_SCHRITT = 3; 

// Loop-Pause für flüssigere P-Regelung (50ms)
const int WARTEZEIT = 50;  

// Bei sehr wenig Licht (Abend/Nacht) nicht mehr nachregeln
const int MIN_GESAMTLICHT = 120;

// Grober Plausibilitätsbereich für LDR-Messwerte
const int SENSOR_MIN_VALID = 2;
const int SENSOR_MAX_VALID = 1021;

// Limits (Mechanischer Schutz)
const int LIMIT_VERT_MIN = 20;   
const int LIMIT_VERT_MAX = 160;
const int LIMIT_HORIZ_MIN = 0;
const int LIMIT_HORIZ_MAX = 180;

// Aktuelle Positionen
int winkelVertikal   = 90; 
int winkelHorizontal = 90; 

// Hilfsfunktion: Berechnet den Regelschritt inkl. Hysterese,
// P-Anteil, Geschwindigkeitsbegrenzung und Anti-Rundungs-Stillstand
int berechneSchritt(int differenz) {
  if (abs(differenz) <= TOLERANZ) {
    return 0;
  }
  float rohSchritt = differenz * Kp;
  int schritt = (int)round(rohSchritt);
  
  // Verhindert Stillstand durch Rundung nahe der Totzone
  if (schritt == 0) {
    schritt = (differenz > 0) ? 1 : -1;
  }
  return constrain(schritt, -MAX_SCHRITT, MAX_SCHRITT);
}

void setup() {
  Serial.begin(9600);
  
  // 1. Motoren zwingend auf 0 Grad setzen, BEVOR der Strom freigegeben wird
  servoHorizontal.write(0);
  servoVertikal.write(0);
  servoHorizontal2.write(0);
  servoVertikal2.write(0);
  
  // 2. Servos aktivieren
  servoHorizontal.attach(PIN_SERVO_HORIZ);
  servoVertikal.attach(PIN_SERVO_VERT);
  servoHorizontal2.attach(PIN_SERVO_HORIZ_2);
  servoVertikal2.attach(PIN_SERVO_VERT_2);

  Serial.println("--- SOLAR TRACKER v2 (P-REGELUNG + DUAL SETUP) GESTARTET ---");
  Serial.println("Kalibrierung: Fahre langsam in die Startposition (90 Grad)...");

  // 3. SANFTER START: Wir zählen von 0 bis 90 hoch, mit Pausen dazwischen
  for (int pos = 0; pos <= 90; pos++) {
    servoHorizontal.write(pos);
    servoVertikal.write(pos);
    servoHorizontal2.write(pos);
    servoVertikal2.write(pos);
    delay(START_GESCHWINDIGKEIT); // Hier greift deine eingestellte Geschwindigkeit!
  }

  Serial.println("Kalibrierung beendet. Tracking beginnt!");
}

void loop() {
  // === A. MESSUNG (MITTELWERTBILDUNG) ===
  long sumOben = 0, sumUnten = 0, sumLinks = 0, sumRechts = 0;

  for (int i = 0; i < MESSUNGEN; i++) {
    sumOben   += analogRead(PIN_OBEN);
    sumUnten  += analogRead(PIN_UNTEN);
    sumLinks  += analogRead(PIN_LINKS);
    sumRechts += analogRead(PIN_RECHTS);
    delay(2); 
  }

  int valOben   = sumOben / MESSUNGEN;
  int valUnten  = sumUnten / MESSUNGEN;
  int valLinks  = sumLinks / MESSUNGEN;
  int valRechts = sumRechts / MESSUNGEN;

  int diffVert = valOben - valUnten;
  int diffHoriz = valRechts - valLinks;
  int gesamtLicht = (valOben + valUnten + valLinks + valRechts) / 4;

  // === B. SERIELLE AUSGABE ===
  Serial.print("O:"); Serial.print(valOben);
  Serial.print(" | U:"); Serial.print(valUnten);
  Serial.print(" | L:"); Serial.print(valLinks);
  Serial.print(" | R:"); Serial.print(valRechts);
  Serial.print(" -> Diff V:"); Serial.print(diffVert);
  Serial.print(" H:"); Serial.print(diffHoriz);
  Serial.print(" [Winkel V:"); Serial.print(winkelVertikal);
  Serial.print(" H:"); Serial.print(winkelHorizontal);
  Serial.print("]");

  // === C. PLAUSIBILITÄTSCHECK ===
  bool sensorUngueltig =
    valOben  <= SENSOR_MIN_VALID || valOben  >= SENSOR_MAX_VALID ||
    valUnten <= SENSOR_MIN_VALID || valUnten >= SENSOR_MAX_VALID ||
    valLinks <= SENSOR_MIN_VALID || valLinks >= SENSOR_MAX_VALID ||
    valRechts<= SENSOR_MIN_VALID || valRechts>= SENSOR_MAX_VALID;

  if (sensorUngueltig) {
    Serial.println(" <--- STATUS: FEHLER! (Sensor ungültig / Kabel ab?)");
    delay(WARTEZEIT);
    return; // Diesen Zyklus überspringen
  }

  // === D. NACHT-/DUNKELHEITSERKENNUNG ===
  if (gesamtLicht < MIN_GESAMTLICHT) {
    Serial.println(" <--- STATUS: NACHTMODUS (Zu dunkel, Motoren ruhen)");
    delay(WARTEZEIT);
    return;
  }

  // Wenn wir hier ankommen, ist alles gut und der Tracker arbeitet
  Serial.println(" <--- STATUS: TRACKING AKTIV");

  // === E. LOGIK VERTIKAL (Oben/Unten) ===
  int schrittV = berechneSchritt(diffVert);
  winkelVertikal -= schrittV;

  // === F. LOGIK HORIZONTAL (Links/Rechts) ===
  int schrittH = berechneSchritt(diffHoriz);
  winkelHorizontal -= schrittH;

  // === G. SICHERHEIT (Begrenzungen) ===
  winkelVertikal   = constrain(winkelVertikal, LIMIT_VERT_MIN, LIMIT_VERT_MAX);
  winkelHorizontal = constrain(winkelHorizontal, LIMIT_HORIZ_MIN, LIMIT_HORIZ_MAX);

  // === H. MOTOR UPDATE (BEIDE AUFBAUTEN) ===
  servoHorizontal.write(winkelHorizontal);
  servoVertikal.write(winkelVertikal);

  servoHorizontal2.write(winkelHorizontal);
  servoVertikal2.write(winkelVertikal);

  // === I. TAKTUNG ===
  delay(WARTEZEIT); 
}
